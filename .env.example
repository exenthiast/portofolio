# ── Public (exposed to the browser; safe by design — RLS protects the data) ──
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>

# ── Server only (Vercel → Project Settings → Environment Variables) ──
# Used by scripts/pull-content.ts (prebuild) and api/*. Can reuse the values above.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
# Vercel → Settings → Git → Deploy Hooks (branch: main). Never prefix with VITE_.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/<id>/<secret>
# Optional: live deploy status in the admin topbar.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
