# ── Public (exposed to the browser; safe by design — RLS protects the data) ──
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>
# Public site key for an Invisible Turnstile widget. Never put its secret here.
# Leave unset until the protected-input rollout in docs/SECURITY.md is ready.
VITE_TURNSTILE_SITE_KEY=

# ── Server only (Cloudflare Worker → Settings → Variables and Secrets) ──
# Used by scripts/pull-content.ts (prebuild) and api/*. Can reuse the values above.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
# Worker runtime secret. Create a Cloudflare Workers Builds deploy hook for main.
# Never prefix this with VITE_. Keep preview secrets separate from production.
CLOUDFLARE_DEPLOY_HOOK_URL=

# Protected public input, Worker runtime only; never prefix secrets with VITE_.
# Service-role JWT bypasses RLS: keep it server-only and separate per environment.
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
# Generate a random secret of at least 32 characters for abuse-limit hashes/proofs.
PUBLIC_INPUT_SECRET=
# Exact allowed browser origin; set the actual preview origin separately.
PUBLIC_INPUT_ORIGIN=https://alfizdesta.dev

# ── Optional legacy Vercel adapter ──
# Vercel → Settings → Git → Deploy Hooks (branch: main). Never prefix with VITE_.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/<id>/<secret>
# Optional: live deploy status in the admin topbar.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ── Operator-only CMS backup (see docs/BACKUP.md; never build/runtime variables) ──
# Export these in a private operator environment. Scripts do not load .env files.
# PG_BIN=/path/to/postgresql/bin
# PGHOST=db.<project-ref>.supabase.co
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres
# PGSSLMODE=verify-full
# PGPASSFILE=/private/path/to/pgpass
# BACKUP_SOURCE_URL=https://<project-ref>.supabase.co
# BACKUP_WRITES_PAUSED=yes
# BACKUP_STORAGE_KEY=  # Optional: server-only service-role key for private buckets
