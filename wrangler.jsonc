{
  "name": "alfizdesta-portfolio",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api", "/api/*", "/admin", "/admin/*"]
  }
}
