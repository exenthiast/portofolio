{
  "name": "alfizdesta-portfolio",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": true,
  "ratelimits": [
    {
      "name": "PUBLIC_INPUT_LIMITER",
      "namespace_id": "151001",
      "simple": { "limit": 90, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api", "/api/*", "/admin", "/admin/*"]
  }
}
